{
  "manifest_version": 3,
  "name": "Base44 Code Downloader",
  "version": "1.0.2",
  "description": "Pobiera kod projektu Base44 z aktywnej karty jako plik ZIP.",
  "action": {
    "default_title": "Base44 Downloader",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://app.base44.com/*"
  ]
}
